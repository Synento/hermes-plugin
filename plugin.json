{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "author": {
    "name": "Synento",
    "url": "https://synento.com"
  },
  "description": "Live video sessions that record themselves. The agent uses a restricted server key, then checks the recording before calling the integration working.",
